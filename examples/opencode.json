{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "file:///absolute/path/to/remem/dist/index.js",
      "options": {
        "providers": [
          {
            "type": "markdown",
            "id": "example-notes",
            "paths": ["examples/memory"],
            "scope": "workspace"
          }
        ],
        "budgets": {
          "catalogTokens": 600,
          "recallTokens": 1400,
          "perProviderTokens": 900
        },
        "planner": {
          "minimumConfidence": 0.42,
          "maxTopics": 3,
          "semantic": true,
          "semanticMinimumSimilarity": 0.55,
          "deterministicHighConfidence": 0.82
        },
        "debug": false
      }
    }
  ]
}
